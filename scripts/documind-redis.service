[Unit]
Description=DocuMind isolated Redis coordination/cache
After=network.target

[Service]
Type=notify
User=redis
Group=redis
ExecStart=/opt/documind-redis/usr/bin/redis-server /etc/documind-redis.conf
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/documind-redis
UMask=0077
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
