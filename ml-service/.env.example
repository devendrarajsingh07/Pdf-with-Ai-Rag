QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_documents_v2

LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-3.8-flash
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048

EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768

RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true

ML_SERVICE_TOKEN=your-internal-service-token-change-this
UPLOAD_DIR=../backend/uploads

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=10
RETRIEVAL_TOP_N=5

LOG_LEVEL=INFO
TESSERACT_CMD=
# Neural weights download on first use. Use tesseract for the lightweight stack.
OCR_BACKEND=doctr
OCR_DEVICE=cpu
OCR_TORCH_THREADS=4
CGAN_REPO_DIR=../.tools/pytorch-cyclegan-and-pix2pix
# A trusted document-cleanup generator state_dict is required for cgan_doctr.
CGAN_CHECKPOINT=
CGAN_CHECKPOINT_SHA256=
CGAN_NET_G=unet_256
CGAN_NORM=batch
CGAN_USE_DROPOUT=false
CGAN_CHANNELS=3
CGAN_NGF=64
CGAN_TILE_SIZE=256
CGAN_TILE_OVERLAP=32
CGAN_MAX_TILES=512
REDIS_URL=
DATA_ENCRYPTION_KEY=
LLM_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash
GEMINI_REQUESTS_PER_MINUTE=10
GEMINI_TOKENS_PER_MINUTE=100000
GEMINI_PROJECT_REQUESTS_PER_MINUTE=60
